<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Reductionish</AssemblyName>
    <RootNamespace>Reductionish</RootNamespace>
    <Nullable>disable</Nullable>
    <GameDir>$(MSBuildProjectDirectory)\..\..</GameDir>
    <ManagedDir>$(GameDir)\Probably Stolen_Data\Managed</ManagedDir>
    <ModInstallDir>$(GameDir)\Mods\Reductionish</ModInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <ModFile Include="manifest.xml;preview.png;Textures\**;Sounds\**;Localization\**;LootTables\**;Books\**" />
    <None Remove="Textures\**;Sounds\**;Localization\**;LootTables\**;Books\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>E:\Steam\steamapps\common\Probably Stolen\Probably Stolen_Data\Managed\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>E:\Steam\steamapps\common\Probably Stolen\Probably Stolen_Data\Managed\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>E:\Steam\steamapps\common\Probably Stolen\Probably Stolen_Data\Managed\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>E:\Steam\steamapps\common\Probably Stolen\Probably Stolen_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="InstallMod" AfterTargets="Build">
    <MakeDir Directories="$(ModInstallDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModInstallDir)" />
    <Copy SourceFiles="@(ModFile)" DestinationFiles="@(ModFile->'$(ModInstallDir)\%(RecursiveDir)%(Filename)%(Extension)')" Condition="Exists('%(ModFile.FullPath)')" />
    <Message Importance="high" Text="Installed into $(ModInstallDir)" />
  </Target>

</Project>
